{
  "id": "community.vacuum-gauge",
  "name": "Vacuum Gauge",
  "version": "1.3.0",
  "minAppVersion": "2.0.0",
  "platforms": {
    "v2": "2.0.225",
    "pro-v2": "2.0.316"
  },
  "author": "Gedas-dev / Daryl",
  "repository": "https://github.com/Gedas-dev/ncsender-plugin-vacuum-gauge",
  "description": "Live vacuum-table pressure from a WiFi ESP32 gauge: a dial under Tools, a floating gauge panel on the main screen, and a low-vacuum check that can warn, pause or stop the job.",
  "category": "utility",
  "icon": "icon.svg",
  "priority": 90,
  "commands": "commands.js",
  "configUi": "config.html",
  "events": [
    "background"
  ],
  "permissions": [
    "network"
  ],
  "toolMenu": [
    {
      "id": "open-vacuum-gauge",
      "label": "Vacuum Gauge",
      "icon": "icon.svg",
      "clientOnly": true
    }
  ],
  "overlay": {
    "page": "overlay.html",
    "title": "Vacuum",
    "area": "screen",
    "corner": "bottom-right",
    "frame": false,
    "width": 320,
    "height": 210,
    "shape": "inset(60px 0px 0px 90px round 12px)"
  }
}
